# Identitas bot
BOT_NAME=Community Exploit Bot
BOT_DESCRIPTION=Exploit, Game Development & Coding Community

# Wajib
DISCORD_TOKEN=
CLIENT_ID=

# Wajib untuk kontrol global owner. Isi dengan Discord user ID pembuat bot.
# Beberapa owner dipisahkan koma; jangan isi username atau ID server.
BOT_OWNER_IDS=

# Opsional: satu atau beberapa ID server untuk registrasi command cepat
GUILD_ID=

# Opsional: daftar plugin inti yang ingin dinonaktifkan, pisahkan dengan koma
DISABLED_PLUGINS=

# Opsional: info, debug, warn, atau error
LOG_LEVEL=info

# Donation QRIS provider (rahasia — isi hanya dalam .env)
# QRIS statis merchant milik penerima donasi; token history HARUS dari merchant yang sama.
GOPAY_STATIC_QR=
GOPAY_HISTORY_TOKEN=

